{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run_manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_directory",
    "timestamp",
    "git_commit",
    "git_dirty",
    "config",
    "config_hash",
    "input_files",
    "random_seed",
    "supplied_models",
    "output_paths",
    "status",
    "warnings",
    "utility_version"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
    },
    "run_directory": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "git_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "git_dirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "config": {
      "type": "object"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "random_seed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "supplied_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "checkpoint_id",
          "seed"
        ],
        "properties": {
          "model_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkpoint_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "output_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "created",
        "running",
        "completed",
        "failed"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "utility_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
