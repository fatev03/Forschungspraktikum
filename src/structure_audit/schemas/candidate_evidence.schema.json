{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate_evidence",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "sequence_hash",
    "target_id",
    "conformer_id",
    "metrics",
    "provenance",
    "warnings",
    "missing_values"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "conformer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "raw_value",
          "value",
          "context",
          "category",
          "unit",
          "scale",
          "source",
          "provenance",
          "missing_reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "raw_value": {},
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "context": {
            "enum": [
              "monomer",
              "complex",
              "counter_screen",
              "unassigned"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "scale": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "row"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "row": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "required": [
              "model_id",
              "checkpoint_id",
              "seed"
            ],
            "properties": {
              "model_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "checkpoint_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "seed": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "missing_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "model_id",
        "checkpoint_id",
        "seed"
      ],
      "properties": {
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_values": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
